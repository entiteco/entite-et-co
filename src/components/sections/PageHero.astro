---
// En-tête des pages intérieures : fil d'Ariane, H1, intro, actions, visuel.
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import ContentImage from '@/components/ui/ContentImage.astro';
import ImagePlaceholder from '@/components/ui/ImagePlaceholder.astro';
import { inlineMarkdown } from '@/lib/inline-markdown';
import type { NavItem } from '@/data/site';
import type { ContentImageData } from '@/lib/image-ratios';

interface Props {
  eyebrow?: string;
  title: string;
  /** Intro ; `**gras**` autorisé. */
  intro?: string;
  breadcrumbs: readonly NavItem[];
  /** Libellé du placeholder ; `false` = pas de visuel (pages légales, contact…). */
  imageLabel?: string | false;
  /** Visuel réel (chargement prioritaire) ; sinon placeholder `imageLabel`. */
  image?: ContentImageData;
  imageRatio?: 'square' | 'portrait' | 'landscape';
  /** Colonne unique centrée, sans visuel (ignore `image` et `imageLabel`). */
  centered?: boolean;
}

const {
  eyebrow,
  title,
  intro,
  breadcrumbs,
  imageLabel = 'Visuel principal',
  imageRatio = 'square',
  image,
  centered = false,
} = Astro.props;

const withImage = !centered && imageLabel !== false;
---

<section class="container-site pt-32 pb-16 sm:pt-40 sm:pb-24">
  <div class:list={['grid items-center gap-12', withImage && 'lg:grid-cols-12']}>
    <div
      class:list={[
        'flex flex-col gap-7',
        withImage && 'lg:col-span-7',
        centered && 'mx-auto max-w-4xl items-center text-center',
      ]}
    >
      <Breadcrumbs items={breadcrumbs} />
      {
        eyebrow && (
          <p class="flex items-center gap-3 font-display text-xs font-medium tracking-[0.3em] text-accent uppercase sm:text-sm">
            <span aria-hidden="true" class="h-px w-8 bg-brand" />
            {eyebrow}
          </p>
        )
      }
      <h1 class="text-4xl leading-[1.02] font-bold text-fg sm:text-6xl lg:text-7xl">{title}</h1>
      {intro && <p class="max-w-[65ch] text-lg text-fg-muted" set:html={inlineMarkdown(intro)} />}
      {
        Astro.slots.has('actions') && (
          <div class:list={['flex flex-wrap gap-3 pt-1', centered && 'justify-center']}>
            <slot name="actions" />
          </div>
        )
      }
    </div>

    {
      withImage && (
        <div class="lg:col-span-5">
          {image ? (
            <ContentImage
              src={image.src}
              alt={image.alt}
              ratio={imageRatio}
              class={image.class}
              sizes="(min-width: 1280px) 480px, (min-width: 1024px) 38vw, calc(100vw - 2.5rem)"
              priority
            />
          ) : (
            <ImagePlaceholder label={imageLabel} description={title} ratio={imageRatio} />
          )}
        </div>
      )
    }
  </div>
</section>
