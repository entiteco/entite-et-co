---
// En-tête des pages intérieures : fil d'Ariane, H1, intro, actions (typographique, sans visuel).
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import { inlineMarkdown } from '@/lib/inline-markdown';
import type { NavItem } from '@/data/site';

interface Props {
  eyebrow?: string;
  title: string;
  /** Intro ; `**gras**` autorisé. */
  intro?: string;
  breadcrumbs: readonly NavItem[];
  /** Colonne unique centrée. */
  centered?: boolean;
}

const { eyebrow, title, intro, breadcrumbs, centered = false } = Astro.props;
---

<section class="container-site pt-32 pb-16 sm:pt-40 sm:pb-24">
  <div
    class:list={[
      'flex max-w-5xl flex-col gap-7',
      centered && 'mx-auto max-w-4xl items-center text-center',
    ]}
  >
    <Breadcrumbs items={breadcrumbs} />
    {
      eyebrow && (
        <p class="flex items-center gap-3 font-display text-xs font-medium tracking-[0.3em] text-accent uppercase sm:text-sm">
          <span aria-hidden="true" class="h-px w-8 bg-brand" />
          {eyebrow}
        </p>
      )
    }
    <h1 class="text-4xl leading-[1.02] font-bold text-fg sm:text-6xl lg:text-7xl">{title}</h1>
    {intro && <p class="max-w-[65ch] text-lg text-fg-muted" set:html={inlineMarkdown(intro)} />}
    {
      Astro.slots.has('actions') && (
        <div class:list={['flex flex-wrap gap-3 pt-1', centered && 'justify-center']}>
          <slot name="actions" />
        </div>
      )
    }
  </div>
</section>
