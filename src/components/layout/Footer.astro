---
import { ArrowRightIcon, EnvelopeIcon } from '@phosphor-icons/react/ssr';
import Logo from '@/components/ui/Logo.astro';
import Button from '@/components/ui/Button.astro';
import SocialLinks from '@/components/ui/SocialLinks.astro';
import { legalNav, localizeNav, mainNav, site } from '@/data/site';
import { getLangFromUrl, localizePath, useTranslations } from '@/i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const expertises = localizeNav(
  mainNav.filter((item) => item.href.startsWith('/expertises/')),
  lang,
);
const studio = localizeNav(
  mainNav.filter((item) => item.href !== '/' && !item.href.startsWith('/expertises/')),
  lang,
);
const legal = localizeNav(legalNav, lang);
const year = new Date().getFullYear();

const linkClass =
  'inline-flex min-h-11 cursor-pointer items-center text-fg-muted transition-colors duration-200 hover:text-fg sm:min-h-9';
const headingClass =
  'mb-4 font-display text-sm font-semibold tracking-[0.2em] text-fg uppercase';
---

<footer class="relative mt-24 border-t border-line">
  <div class="container-site flex flex-col gap-16 py-16 sm:py-20">
    <div class="grid gap-12 lg:grid-cols-12">
      <div class="flex flex-col gap-6 lg:col-span-5">
        <a href={localizePath('/', lang)} class="w-fit cursor-pointer">
          <Logo height={40} />
          <span class="sr-only"> — {t('nav.home')}</span>
        </a>
        <p class="max-w-sm text-fg-muted">{t('site.slogan')}</p>
        <Button href={localizePath('/contact', lang)} icon={ArrowRightIcon} class="w-fit">
          {t('common.discussProject')}
        </Button>
      </div>

      <nav aria-label={t('footer.expertises')} class="lg:col-span-2">
        <h2 class={headingClass}>{t('footer.expertises')}</h2>
        <ul class="flex flex-col gap-1">
          {
            expertises.map((item) => (
              <li>
                <a href={item.href} class={linkClass}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-label={t('footer.studio')} class="lg:col-span-2">
        <h2 class={headingClass}>{t('footer.studio')}</h2>
        <ul class="flex flex-col gap-1">
          {
            studio.map((item) => (
              <li>
                <a href={item.href} class={linkClass}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="lg:col-span-3">
        <h2 class={headingClass}>{t('footer.contact')}</h2>
        <a href={`mailto:${site.email}`} class:list={[linkClass, 'gap-2.5']}>
          <EnvelopeIcon aria-hidden="true" className="size-5 text-accent" weight="regular" />
          {site.email}
        </a>
        <SocialLinks class="mt-1" />
      </div>
    </div>

    <div
      class="flex flex-col gap-4 border-t border-line pt-8 text-sm text-fg-muted sm:flex-row sm:items-center sm:justify-between"
    >
      <p>© {year} {site.name}. {t('footer.rights')}</p>
      <ul class="flex flex-wrap gap-x-6 gap-y-1">
        {
          legal.map((item) => (
            <li>
              <a href={item.href} class={linkClass}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <!-- Signature typographique géante, purement décorative (SVG : hors calcul de contraste) -->
  <svg
    aria-hidden="true"
    focusable="false"
    viewBox="0 0 1000 250"
    class="pointer-events-none block w-full fill-fg/[0.04] font-display font-bold select-none"
  >
    <text
      x="500"
      y="235"
      text-anchor="middle"
      textLength="960"
      lengthAdjust="spacingAndGlyphs"
      font-size="240">ENTITÉ</text
    >
  </svg>
</footer>
