---
// Préfixe les attributs id du contenu enfant (ex. titres Markdown), pour éviter les id
// dupliqués quand plusieurs contenus sont rendus sur une même page (modales du portfolio).
// Les ancres internes (href="#…") du contenu sont réécrites en conséquence.
interface Props {
  prefix: string;
}

const { prefix } = Astro.props;
const html = await Astro.slots.render('default');
const prefixed = html
  .replace(/ id="([^"]+)"/g, ` id="${prefix}-$1"`)
  .replace(/ href="#([^"]+)"/g, ` href="#${prefix}-$1"`);
---

<Fragment set:html={prefixed} />
