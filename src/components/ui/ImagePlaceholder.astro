---
// Espace réservé pour les visuels (phase maquette : aucune vraie image).
// Le ratio est réservé pour éviter tout décalage de mise en page (CLS).
import type { Icon } from '@phosphor-icons/react';
import { ImageSquareIcon } from '@phosphor-icons/react/ssr';

type Ratio = 'video' | 'square' | 'portrait' | 'landscape' | 'wide';

interface Props {
  label?: string;
  /** Décrit le visuel attendu, pour les lecteurs d'écran et l'intégration future. */
  description?: string;
  ratio?: Ratio;
  icon?: Icon;
  class?: string;
}

const {
  label = 'Ajouter une image',
  description,
  ratio = 'video',
  icon: PlaceholderIcon = ImageSquareIcon,
  class: className = '',
} = Astro.props;

const ratios: Record<Ratio, string> = {
  video: 'aspect-video',
  square: 'aspect-square',
  portrait: 'aspect-[4/5]',
  landscape: 'aspect-[4/3]',
  wide: 'aspect-[21/9]',
};
---

<div
  role="img"
  aria-label={description ? `${label} : ${description}` : label}
  class:list={[
    'relative flex w-full flex-col items-center justify-center gap-3 overflow-hidden rounded-xl border border-placeholder-line bg-placeholder text-fg-muted',
    ratios[ratio],
    className,
  ]}
>
  <div
    aria-hidden="true"
    class="absolute inset-0 bg-[radial-gradient(circle_at_50%_120%,var(--halo),transparent_60%)]"
  >
  </div>
  <PlaceholderIcon
    aria-hidden="true"
    className="relative size-8 text-placeholder-icon"
    weight="light"
  />
  <span
    aria-hidden="true"
    class="relative px-4 text-center font-display text-xs tracking-[0.2em] uppercase"
  >
    {label}
  </span>
</div>
