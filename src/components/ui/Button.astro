---
import type { Icon } from '@phosphor-icons/react';
import type { HTMLAttributes } from 'astro/types';

type Variant = 'primary' | 'secondary' | 'ghost';
type Size = 'md' | 'lg';

type Props = {
  variant?: Variant;
  size?: Size;
  /** Icône Phosphor affichée après le libellé (décorative). */
  icon?: Icon;
  class?: string;
} & (
  | ({ href: string } & Omit<HTMLAttributes<'a'>, 'class'>)
  | ({ href?: never } & Omit<HTMLAttributes<'button'>, 'class'>)
);

const {
  variant = 'primary',
  size = 'md',
  icon: Icon,
  class: className = '',
  href,
  ...attrs
} = Astro.props;

const base =
  'group/btn relative isolate inline-flex min-h-12 cursor-pointer items-center justify-center gap-2 overflow-hidden rounded-full font-display font-semibold tracking-tight transition-[color,border-color,background-color] duration-300 ease-out-expo disabled:pointer-events-none disabled:opacity-50';

const sizes: Record<Size, string> = {
  md: 'px-6 text-sm',
  lg: 'px-8 text-base',
};

// primary : fond transparent qui se remplit de rouge du bas vers le haut au survol.
const variants: Record<Variant, string> = {
  primary:
    'border border-brand text-fg hover:text-white focus-visible:text-white before:absolute before:inset-0 before:-z-10 before:origin-bottom before:scale-y-0 before:bg-brand before:transition-transform before:duration-300 before:ease-out-expo hover:before:scale-y-100 focus-visible:before:scale-y-100',
  secondary: 'border border-line-strong text-fg hover:border-fg/40 hover:bg-fg/5',
  ghost: 'px-0! text-fg hover:text-accent',
};

const classes = [base, sizes[size], variants[variant], className];
const iconClass =
  'size-4 shrink-0 transition-transform duration-300 ease-out-expo group-hover/btn:translate-x-0.5';
const anchorAttrs = attrs as Omit<HTMLAttributes<'a'>, 'class'>;
const buttonAttrs = attrs as Omit<HTMLAttributes<'button'>, 'class'>;
---

{
  href ? (
    <a href={href} class:list={classes} {...anchorAttrs}>
      <slot />
      {Icon && <Icon aria-hidden="true" className={iconClass} weight="bold" />}
    </a>
  ) : (
    <button type="button" class:list={classes} {...buttonAttrs}>
      <slot />
      {Icon && <Icon aria-hidden="true" className={iconClass} weight="bold" />}
    </button>
  )
}
