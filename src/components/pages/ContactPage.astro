---
// Page Contact (/contact et /en/contact).
import { EnvelopeIcon, PaperPlaneTiltIcon } from '@phosphor-icons/react/ssr';
import Layout from '@/layouts/Layout.astro';
import PageHero from '@/components/sections/PageHero.astro';
import FormField from '@/components/ui/FormField.astro';
import SocialLinks from '@/components/ui/SocialLinks.astro';
import { getExpertises } from '@/data/expertises';
import { site } from '@/data/site';
import type { Lang } from '@/i18n/ui';
import { localizePath } from '@/i18n/utils';
import type { ContactScriptCopy } from '@/lib/contact-copy';

interface Props {
  lang: Lang;
}

interface ContactCopy {
  seo: { title: string; description: string };
  navLabel: string;
  hero: { title: string; intro: string };
  form: {
    title: string;
    requiredNote: [string, string];
    name: string;
    company: string;
    email: string;
    phone: string;
    subject: string;
    subjectPlaceholder: string;
    other: string;
    message: string;
    messageHint: string;
    consent: [string, string];
    submit: string;
  };
  aside: { title: string; writeUs: string; socials: string; expertises: string };
  script: ContactScriptCopy;
}

const copy: Record<Lang, ContactCopy> = {
  fr: {
    seo: {
      title: 'Contact | Discutons de votre projet | Entité & Co',
      description:
        'Un projet web, data, IA ou textile ? Contactez Entité & Co par formulaire ou par email à contact@entite.co.',
    },
    navLabel: 'Contact',
    hero: {
      title: 'Discutons de votre projet',
      intro:
        'Data & IA, création digitale ou impression textile : une seule entité pour connecter tous les points de votre projet. Décrivez-nous votre besoin, nous revenons vers vous.',
    },
    form: {
      title: 'Formulaire de contact',
      requiredNote: ["Les champs marqués d'un", 'sont obligatoires.'],
      name: 'Nom et prénom',
      company: 'Entreprise',
      email: 'Adresse email',
      phone: 'Téléphone',
      subject: 'Votre projet concerne',
      subjectPlaceholder: 'Choisissez une expertise',
      other: 'Autre demande',
      message: 'Votre message',
      messageHint:
        'Contexte, objectifs, délais, budget : tout ce qui nous aide à bien comprendre votre besoin.',
      consent: [
        "J'accepte que mes données soient utilisées pour traiter ma demande, conformément à la",
        'politique de confidentialité',
      ],
      submit: 'Envoyer le message',
    },
    aside: {
      title: 'Coordonnées',
      writeUs: 'Écrivez-nous directement',
      socials: 'Réseaux sociaux',
      expertises: 'Nos expertises',
    },
    script: {
      required: 'Ce champ est obligatoire.',
      requiredCheckbox: 'Merci de cocher cette case pour que nous puissions traiter votre demande.',
      requiredSelect: 'Merci de choisir une expertise.',
      invalidEmail: 'Merci de saisir une adresse email valide (ex. nom@domaine.fr).',
      errorsOne: 'Le formulaire contient {n} erreur.',
      errorsMany: 'Le formulaire contient {n} erreurs.',
      opening:
        'Votre messagerie va s’ouvrir avec votre message pré-rempli. Si rien ne se passe, écrivez-nous directement à {email}.',
      subject: 'Projet',
      labels: { name: 'Nom', company: 'Entreprise', email: 'Email', phone: 'Téléphone', project: 'Projet' },
    },
  },
  en: {
    seo: {
      title: "Contact | Let's discuss your project | Entité & Co",
      description:
        'A web, data, AI or textile project? Contact Entité & Co via the form or by email at contact@entite.co.',
    },
    navLabel: 'Contact',
    hero: {
      title: "Let's discuss your project",
      intro:
        'Data & AI, digital design or textile printing: a single entity to connect every dot of your project. Tell us what you need and we will get back to you.',
    },
    form: {
      title: 'Contact form',
      requiredNote: ['Fields marked with', 'are required.'],
      name: 'Full name',
      company: 'Company',
      email: 'Email address',
      phone: 'Phone',
      subject: 'Your project is about',
      subjectPlaceholder: 'Choose an area of expertise',
      other: 'Other request',
      message: 'Your message',
      messageHint:
        'Context, goals, timeline, budget: anything that helps us understand your needs.',
      consent: [
        'I agree that my data may be used to process my request, in accordance with the',
        'privacy policy (FR)',
      ],
      submit: 'Send message',
    },
    aside: {
      title: 'Contact details',
      writeUs: 'Write to us directly',
      socials: 'Social media',
      expertises: 'Our expertise',
    },
    script: {
      required: 'This field is required.',
      requiredCheckbox: 'Please tick this box so that we can process your request.',
      requiredSelect: 'Please choose an area of expertise.',
      invalidEmail: 'Please enter a valid email address (e.g. name@domain.com).',
      errorsOne: 'The form contains {n} error.',
      errorsMany: 'The form contains {n} errors.',
      opening:
        'Your email app will open with your message pre-filled. If nothing happens, write to us directly at {email}.',
      subject: 'Project',
      labels: { name: 'Name', company: 'Company', email: 'Email', phone: 'Phone', project: 'Project' },
    },
  },
};

const { lang } = Astro.props;
const c = copy[lang];
const l = (path: string) => localizePath(path, lang);
const expertises = getExpertises(lang);
const breadcrumbs = [{ label: c.navLabel, href: l('/contact') }];

const subjects = [
  ...expertises.map((item) => ({ value: item.slug, label: item.navLabel })),
  { value: 'autre', label: c.form.other },
];
---

<Layout title={c.seo.title} description={c.seo.description} breadcrumbs={breadcrumbs}>
  <PageHero eyebrow={c.navLabel} title={c.hero.title} intro={c.hero.intro} breadcrumbs={breadcrumbs} />

  <section class="container-site pb-16 sm:pb-24">
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
      <!-- Sans JS : envoi natif via le client mail. Avec JS : validation en ligne + mailto pré-rempli. -->
      <form
        data-contact-form
        data-copy={JSON.stringify(c.script)}
        action={`mailto:${site.email}`}
        method="post"
        enctype="text/plain"
        aria-labelledby="formulaire-titre"
        class="glass flex flex-col gap-6 rounded-3xl p-6 sm:p-10 lg:col-span-7"
      >
        <div class="flex flex-col gap-2">
          <h2 id="formulaire-titre" class="text-2xl font-bold text-fg sm:text-3xl">
            {c.form.title}
          </h2>
          <p class="text-sm text-fg-muted">
            {c.form.requiredNote[0]} <span class="text-accent">*</span>
            {c.form.requiredNote[1]}
          </p>
        </div>

        <div class="grid gap-6 sm:grid-cols-2">
          <FormField id="nom" label={c.form.name} required autocomplete="name" />
          <FormField id="entreprise" label={c.form.company} autocomplete="organization" />
          <FormField
            id="email"
            label={c.form.email}
            type="email"
            required
            autocomplete="email"
            inputmode="email"
          />
          <FormField id="telephone" label={c.form.phone} type="tel" autocomplete="tel" inputmode="tel" />
        </div>

        <div class="flex flex-col gap-2" data-field>
          <label for="sujet" class="font-display text-sm font-semibold text-fg">
            {c.form.subject} <span class="text-accent" aria-hidden="true">*</span>
          </label>
          <select
            id="sujet"
            name="sujet"
            required
            aria-describedby="sujet-erreur"
            class="min-h-12 w-full cursor-pointer rounded-xl border border-line-strong bg-surface px-4 text-base text-fg transition-[border-color,box-shadow] duration-200 hover:border-fg/40 focus:border-accent focus:ring-4 focus:ring-brand/15 focus:outline-none aria-invalid:border-accent"
          >
            <option value="">{c.form.subjectPlaceholder}</option>
            {subjects.map((subject) => <option value={subject.value}>{subject.label}</option>)}
          </select>
          <p id="sujet-erreur" class="text-sm font-medium text-accent empty:hidden" data-error></p>
        </div>

        <FormField id="message" label={c.form.message} required multiline hint={c.form.messageHint} />

        <div class="flex flex-col gap-2" data-field>
          <div class="flex items-start gap-3">
            <input
              id="consentement"
              name="consentement"
              type="checkbox"
              required
              aria-describedby="consentement-erreur"
              class="mt-0.5 size-5 shrink-0 cursor-pointer rounded accent-brand"
            />
            <label for="consentement" class="cursor-pointer text-sm text-fg-muted">
              {c.form.consent[0]}
              <a
                href="/politique-de-confidentialite"
                class="text-fg underline decoration-brand decoration-2 underline-offset-4 hover:text-accent"
                >{c.form.consent[1]}</a
              >. <span class="text-accent" aria-hidden="true">*</span>
            </label>
          </div>
          <p id="consentement-erreur" class="text-sm font-medium text-accent empty:hidden" data-error>
          </p>
        </div>

        <div class="flex flex-col gap-4 sm:flex-row sm:items-center">
          <button
            type="submit"
            class="group/btn relative isolate inline-flex min-h-12 w-full cursor-pointer items-center justify-center gap-2 overflow-hidden rounded-full border border-brand bg-brand px-8 font-display text-base font-semibold text-white transition-colors duration-300 ease-out-expo hover:bg-brand-hover sm:w-fit"
          >
            {c.form.submit}
            <PaperPlaneTiltIcon
              aria-hidden="true"
              className="size-5 transition-transform duration-300 ease-out-expo group-hover/btn:translate-x-0.5 group-hover/btn:-translate-y-0.5"
              weight="bold"
            />
          </button>
        </div>

        <p role="status" data-form-status class="text-sm text-fg-muted empty:hidden"></p>
      </form>

      <aside aria-labelledby="coordonnees" class="flex flex-col gap-6 lg:col-span-5">
        <h2 id="coordonnees" class="text-2xl font-bold text-fg sm:text-3xl">{c.aside.title}</h2>

        <a
          href={`mailto:${site.email}`}
          class="glass card-hover group/mail flex cursor-pointer items-center gap-4 rounded-2xl p-6"
        >
          <span class="grid size-12 shrink-0 place-items-center rounded-full bg-brand text-white">
            <EnvelopeIcon aria-hidden="true" className="size-6" weight="regular" />
          </span>
          <span class="flex min-w-0 flex-col">
            <span class="text-sm text-fg-muted">{c.aside.writeUs}</span>
            <span
              class="font-display text-lg font-semibold break-all text-fg transition-colors duration-200 group-hover/mail:text-accent sm:text-xl"
            >
              {site.email}
            </span>
          </span>
        </a>

        <div class="glass rounded-2xl p-6">
          <h3 class="font-display text-sm font-semibold tracking-[0.2em] text-fg uppercase">
            {c.aside.socials}
          </h3>
          <SocialLinks class="mt-3" />
        </div>

        <div class="glass rounded-2xl p-6">
          <h3 class="font-display text-sm font-semibold tracking-[0.2em] text-fg uppercase">
            {c.aside.expertises}
          </h3>
          <ul class="mt-3 flex flex-col gap-1">
            {
              expertises.map((item) => (
                <li>
                  <a
                    href={l(`/expertises/${item.slug}`)}
                    class="inline-flex min-h-11 cursor-pointer items-center text-fg-muted transition-colors duration-200 hover:text-fg sm:min-h-9"
                  >
                    {item.navLabel}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </aside>
    </div>
  </section>
</Layout>

<script>
  import { site } from '@/data/site';
  import { formatCount } from '@/i18n/utils';
  import type { ContactScriptCopy } from '@/lib/contact-copy';

  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  const status = form?.querySelector<HTMLElement>('[data-form-status]');

  if (form && status && form.dataset.copy) {
    const copy = JSON.parse(form.dataset.copy) as ContactScriptCopy;

    const messages: Record<string, (field: HTMLInputElement) => string> = {
      valueMissing: (field) =>
        field.type === 'checkbox'
          ? copy.requiredCheckbox
          : field.tagName === 'SELECT'
            ? copy.requiredSelect
            : copy.required,
      typeMismatch: () => copy.invalidEmail,
    };

    const validate = (field: HTMLInputElement): boolean => {
      const error = field.closest('[data-field]')?.querySelector<HTMLElement>('[data-error]');
      const key = (['valueMissing', 'typeMismatch'] as const).find((k) => field.validity[k]);
      const message = key ? (messages[key]?.(field) ?? '') : '';
      if (message) field.setAttribute('aria-invalid', 'true');
      else field.removeAttribute('aria-invalid');
      if (error) error.textContent = message;
      return !message;
    };

    // Validation personnalisée (messages dans la langue de la page, près du champ).
    form.noValidate = true;
    const fields = Array.from(
      form.querySelectorAll<HTMLInputElement>('input, select, textarea'),
    );

    // Pré-sélection depuis les CTA des pages d'expertise (?sujet=data-ia…).
    const subject = new URLSearchParams(location.search).get('sujet');
    const select = form.querySelector<HTMLSelectElement>('#sujet');
    if (subject && select && Array.from(select.options).some((o) => o.value === subject)) {
      select.value = subject;
    }

    fields.forEach((field) => {
      // Revalide après une première erreur, sans harceler pendant la saisie initiale.
      field.addEventListener('input', () => {
        if (field.hasAttribute('aria-invalid')) validate(field);
      });
      field.addEventListener('blur', () => {
        if (field.value) validate(field);
      });
    });

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const invalid = fields.filter((field) => !validate(field));
      if (invalid.length > 0) {
        status.textContent = formatCount(invalid.length, copy.errorsOne, copy.errorsMany);
        invalid[0]?.focus();
        return;
      }

      const data = new FormData(form);
      const value = (key: string) => String(data.get(key) ?? '').trim();
      const subjectLabel = select?.selectedOptions[0]?.textContent ?? '';
      const optional = (label: string, key: string) =>
        value(key) ? [`${label} : ${value(key)}`] : [];
      const body = [
        `${copy.labels.name} : ${value('nom')}`,
        ...optional(copy.labels.company, 'entreprise'),
        `${copy.labels.email} : ${value('email')}`,
        ...optional(copy.labels.phone, 'telephone'),
        `${copy.labels.project} : ${subjectLabel}`,
        '',
        value('message'),
      ].join('\n');

      const href = `mailto:${site.email}?subject=${encodeURIComponent(
        `${copy.subject} ${subjectLabel} — ${value('nom')}`,
      )}&body=${encodeURIComponent(body)}`;

      status.textContent = copy.opening.replace('{email}', site.email);
      window.location.href = href;
    });
  }
</script>
