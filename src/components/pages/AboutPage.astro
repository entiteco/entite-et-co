const references = [
  'Satisfait Services',
  'Au Chai de Jérôme',
  'Adelante Polo Team',
  'Amplitude 64',
  'Optique Medar',
  'Le Petit Pont',
  'La Yeyette au Rhum',
  'Balek',
  'CFDT Enedis',
] as const;

const { lang } = Astro.props;
const c = copy[lang];
const l = (path: string) => localizePath(path, lang);
const breadcrumbs = [{ label: c.navLabel, href: l('/a-propos') }];
const pointIcons = [GraduationCapIcon, StackIcon] as const;

const founderLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Kévin Heugas',
  jobTitle: c.founder.role,
  worksFor: { '@type': 'Organization', name: 'Entité & Co' },
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'EFREI' },
  sameAs: ['https://www.linkedin.com/in/kevinheugas/'],
};
---

<Layout title={c.seo.title} description={c.seo.description} breadcrumbs={breadcrumbs}>
  <script type="application/ld+json" set:html={JSON.stringify(founderLd)} />

  <PageHero
    eyebrow={c.navLabel}
    title={c.hero.title}
    intro={c.hero.intro}
    breadcrumbs={breadcrumbs}
    centered
  />

  <!-- Philosophie -->
  <section aria-labelledby="philosophie" class="container-site border-t border-line py-16 sm:py-24">
    <div class="grid gap-10 lg:grid-cols-12">
      <h2
        id="philosophie"
        class="text-4xl leading-[0.95] font-bold text-fg sm:text-6xl lg:col-span-6"
      >
        {c.philosophy.title}
      </h2>
      <p
        class="reveal text-lg text-fg-muted lg:col-span-6 lg:pt-3 sm:text-xl"
        set:html={inlineMarkdown(c.philosophy.text)}
      />
    </div>
  </section>

  <!-- Vision 360° -->
  <section aria-labelledby="vision-titre" class="container-site py-16 sm:py-24">
    <SectionHeading eyebrow={c.vision.eyebrow} title={c.vision.title}>
      <p>{c.vision.intro}</p>
    </SectionHeading>
    <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        c.poles.map((pole, i) => (
          <div class="reveal" style={`--reveal-start: ${i * 8}%`}>
            <ServiceCard
              title={pole.title}
              description={pole.description}
              icon={expertiseIcons[pole.slug]}
              href={l(`/expertises/${pole.slug}`)}
              linkLabel={c.vision.link}
            />
          </div>
        ))
      }
    </div>
  </section>

  <!-- Fondateur -->
  <section aria-labelledby="fondateur" class="container-site border-t border-line py-16 sm:py-24">
    <div class="grid items-start gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:sticky lg:top-28 lg:col-span-5">
        <ContentImage
          src={founderImg}
          alt={c.founder.alt}
          ratio="portrait"
          class="object-top"
          sizes="(min-width: 1280px) 480px, (min-width: 1024px) 38vw, calc(100vw - 2.5rem)"
        />
      </div>
      <div class="flex flex-col gap-6 lg:col-span-7">
        <p class="font-display text-sm font-medium tracking-[0.3em] text-accent uppercase">
          {c.founder.eyebrow}
        </p>
        <h2 id="fondateur" class="text-4xl leading-[1.02] font-bold text-fg sm:text-6xl">
          Kévin HEUGAS
        </h2>
        <p class="font-display text-lg text-fg">{c.founder.role}</p>
        <p class="text-lg text-fg-muted">{c.founder.intro}</p>

        <ul class="flex flex-col gap-4">
          {
            c.founder.points.map((point, i) => {
              const PointIcon = pointIcons[i] ?? StackIcon;
              return (
                <li class="glass flex gap-4 rounded-2xl p-5 sm:p-6">
                  <PointIcon aria-hidden="true" className="mt-0.5 size-6 shrink-0 text-accent" weight="regular" />
                  <p class="text-fg-muted" set:html={inlineMarkdown(point)} />
                </li>
              );
            })
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- Références -->
  <section aria-labelledby="references" class="container-site border-t border-line py-16 sm:py-24">
    <div class="grid gap-12 lg:grid-cols-12">
      <div class="flex flex-col gap-6 lg:col-span-5">
        <span
          class="grid size-12 place-items-center rounded-full border border-line bg-fg/5 text-accent"
        >
          <HandshakeIcon aria-hidden="true" className="size-6" weight="regular" />
        </span>
        <h2 id="references" class="text-3xl leading-[1.05] font-bold text-fg sm:text-5xl">
          {c.references.title}
        </h2>
        <p class="text-lg text-fg-muted">{c.references.text}</p>
      </div>
      <div class="lg:col-span-7">
        <p class="mb-5 text-sm text-fg-muted italic">{c.references.lead}</p>
        <ul class="grid grid-cols-2 gap-3 sm:grid-cols-3">
          {
            references.map((name) => (
              <li class="glass flex min-h-20 items-center justify-center rounded-xl px-4 py-3 text-center font-display font-semibold text-fg">
                {name}
              </li>
            ))
          }
          <li
            class="flex min-h-20 items-center justify-center rounded-xl border border-dashed border-line-strong px-4 py-3 text-center text-sm text-fg-muted"
          >
            {c.references.more}
          </li>
        </ul>
        <div class="mt-8">
          <Button href={l('/portfolio')} variant="secondary" icon={ArrowRightIcon}>
            {c.references.cta}
          </Button>
        </div>
      </div>
    </div>
  </section>

  <CtaSection
    title={c.closing.title}
    text={c.closing.text}
    cta={{ label: c.closing.cta, href: l('/contact') }}
  />
</Layout>
