---
// Page À Propos (/a-propos et /en/a-propos). Contenu FR : migration-entite/page-a-propos/page_propos.md
// Seule image de contenu du site : la photo du fondateur.
import { ArrowRightIcon, GraduationCapIcon, HandshakeIcon, StackIcon } from '@phosphor-icons/react/ssr';
import Layout from '@/layouts/Layout.astro';
import PageHero from '@/components/sections/PageHero.astro';
import CtaSection from '@/components/sections/CtaSection.astro';
import Button from '@/components/ui/Button.astro';
import ContentImage from '@/components/ui/ContentImage.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import ServiceCard from '@/components/ui/ServiceCard.astro';
import { expertiseIcons } from '@/data/expertise-icons';
import type { ExpertiseSlug } from '@/data/expertises';
import type { Lang } from '@/i18n/ui';
import { localizePath } from '@/i18n/utils';
import { inlineMarkdown } from '@/lib/inline-markdown';
import founderImg from '@/assets/page-a-propos/entite_co_kevin_heugas.webp';

interface Props {
  lang: Lang;
}

interface AboutCopy {
  seo: { title: string; description: string };
  navLabel: string;
  hero: { title: string; intro: string };
  philosophy: { title: string; text: string };
  vision: { eyebrow: string; title: string; intro: string; link: string };
  poles: readonly { slug: ExpertiseSlug; title: string; description: string }[];
  founder: {
    alt: string;
    eyebrow: string;
    role: string;
    intro: string;
    /** `**gras**` autorisé. */
    points: readonly [string, string];
  };
  references: { title: string; text: string; lead: string; more: string; cta: string };
  closing: { title: string; text: string; cta: string };
}

const copy: Record<Lang, AboutCopy> = {
  fr: {
    seo: {
      title: "À Propos d'Entité & Co | L'écosystème Digital, Data et Créatif",
