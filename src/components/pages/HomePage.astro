---
// Page d'accueil (/ et /en). Contenu FR : migration-entite/page-accueil/page_accueil.md
import { ArrowDownIcon, ArrowRightIcon } from '@phosphor-icons/react/ssr';
import Layout from '@/layouts/Layout.astro';
import Button from '@/components/ui/Button.astro';
import { expertiseIcons } from '@/data/expertise-icons';
import type { ExpertiseSlug } from '@/data/expertises';
import type { Lang } from '@/i18n/ui';
import { localizePath, useTranslations } from '@/i18n/utils';
import { inlineMarkdown } from '@/lib/inline-markdown';

interface Props {
  lang: Lang;
}

interface HomeExpertise {
  slug: ExpertiseSlug;
  title: string;
  text: string;
  items: readonly string[];
  cta: string;
}

interface HomeCopy {
  seo: { title: string; description: string };
  hero: { title: [string, string]; intro: string; cta: string };
  stackLabel: string;
  primaryLabel: string;
  /** Offre principale (carte pleine largeur). */
  primary: HomeExpertise;
  ecosystem: { eyebrow: string; title: string; intro: string };
  /** Compétences transverses (cartes secondaires). */
  transverse: readonly HomeExpertise[];
  philosophy: { eyebrow: string; title: string; question: string; text: string };
}

const keyStack = ['Python', 'SQL', 'PostgreSQL', 'PySpark', 'Docker', 'FastAPI', 'Scikit-Learn', 'LLM & RAG'] as const;

const copy: Record<Lang, HomeCopy> = {
  fr: {
    seo: {
      title: 'Expert Data Engineering & Intelligence Artificielle | Entité & Co',
      description:
        'Architectures de données robustes, automatisation MLOps et modèles prédictifs sur-mesure. Création web et impression textile en compétences transverses.',
    },
    hero: {
      title: ['Expertise Data Engineering', 'Intelligence Artificielle'],
      intro:
        "Conception d'architectures de données robustes, automatisation MLOps et déploiement de modèles prédictifs sur-mesure.",
      cta: "Découvrir l'expertise",
    },
    stackLabel: 'Technologies clés',
    primaryLabel: "Cœur d'expertise",
    primary: {
      slug: 'data-ia',
      title: 'Data & Intelligence Artificielle',
      text: "Accélérez votre business avec la force de l'IA et de la data. Nous transformons vos bases de données brutes en décisions stratégiques et développons des solutions prédictives sur-mesure pour automatiser votre croissance.",
      items: [
        '**Data Engineering & MLOps :** Architecture de bases de données (SQL/NoSQL), création de Data Lakes et automatisation de pipelines (CI/CD) sur le Cloud.',
        '**Data Science & IA :** Machine Learning, traitement du langage (NLP), modèles prédictifs.',
        '**Data Analyse & BI :** Tableaux de bord interactifs (Power BI), analyse de données, automatisation de reportings.',
      ],
      cta: "Explorer l'expertise Data & IA",
    },
    ecosystem: {
      eyebrow: 'Écosystème',
      title: 'Compétences transverses',
      intro:
        'Au-delà de la donnée, deux savoir-faire complémentaires pour donner une interface et une présence physique à vos projets.',
    },
    transverse: [
      {
        slug: 'creation-digitale',
        title: 'Création Digitale & Web',
        text: "Construisons ensemble votre identité digitale. Votre présence en ligne est votre premier point de contact : elle se doit d'être esthétique, ergonomique et conçue pour convertir.",
        items: [
          '**Développement Web :** Sites vitrines performants et plateformes e-commerce (WooCommerce, PrestaShop).',
          '**Graphisme & Branding :** Création de logos, chartes graphiques et identités visuelles complètes.',
          '**Visibilité :** Gestion de marketplaces et stratégies de community management pour fidéliser votre audience.',
        ],
        cta: 'Découvrir le Studio Web',
      },
      {
        slug: 'impression-textile',
        title: 'Impression Textile & Merchandising',
        text: 'Vous cherchez à mettre en avant votre activité dans le monde réel ? Donnez vie à votre marque avec des vêtements et objets promotionnels de qualité professionnelle, imprimés selon vos besoins.',
        items: [
          '**Marquage Textile :** Sérigraphie, flocage, impression numérique (DTG), broderie et sublimation.',
          '**Objets publicitaires :** Gobelets réutilisables (Ecocups), stickers, casquettes et accessoires sur-mesure.',
          '**Production centralisée :** De la petite série à la production événementielle massive.',
        ],
        cta: "Voir les solutions d'Impression",
      },
    ],
    philosophy: {
      eyebrow: 'Notre philosophie',
      title: 'Un est tout, tout est un.',
      question:
        'Pourquoi multiplier les prestataires quand une seule entité peut maîtriser toute votre chaîne de valeur ?',
      text: "C'est la philosophie d'**Entité & Co**. De la conception de votre identité visuelle, au développement de votre plateforme web boostée par l'Intelligence Artificielle, jusqu'à l'impression physique de votre merchandising : nous connectons tous les points de votre projet. Une vision globale pour un résultat cohérent et percutant.",
    },
  },
  en: {
    seo: {
      title: 'Data Engineering & Artificial Intelligence Expert | Entité & Co',
      description:
        'Robust data architectures, MLOps automation and custom predictive models. Web design and textile printing as cross-functional skills.',
    },
    hero: {
      title: ['Data Engineering', 'Artificial Intelligence Expertise'],
      intro:
        'Designing robust data architectures, automating MLOps and deploying custom predictive models.',
      cta: 'Explore the expertise',
    },
    stackLabel: 'Key technologies',
    primaryLabel: 'Core expertise',
    primary: {
      slug: 'data-ia',
      title: 'Data & Artificial Intelligence',
      text: 'Accelerate your business with the power of AI and data. We turn your raw databases into strategic decisions and build custom predictive solutions to automate your growth.',
      items: [
        '**Data Engineering & MLOps:** Database architecture (SQL/NoSQL), Data Lakes and automated pipelines (CI/CD) in the Cloud.',
        '**Data Science & AI:** Machine Learning, natural language processing (NLP), predictive models.',
        '**Data Analysis & BI:** Interactive dashboards (Power BI), data analysis, automated reporting.',
      ],
      cta: 'Explore the Data & AI expertise',
    },
    ecosystem: {
      eyebrow: 'Ecosystem',
      title: 'Cross-functional skills',
      intro:
        'Beyond data, two complementary skill sets to give your projects an interface and a physical presence.',
    },
    transverse: [
      {
        slug: 'creation-digitale',
        title: 'Digital Design & Web',
        text: 'Let’s build your digital identity together. Your online presence is your first point of contact: it has to be beautiful, user-friendly and designed to convert.',
        items: [
          '**Web Development:** High-performing showcase sites and e-commerce platforms (WooCommerce, PrestaShop).',
          '**Graphic Design & Branding:** Logos, brand guidelines and complete visual identities.',
          '**Visibility:** Marketplace management and community management strategies to build audience loyalty.',
        ],
        cta: 'Discover the Web Studio',
      },
      {
        slug: 'impression-textile',
        title: 'Textile Printing & Merchandising',
        text: 'Want to showcase your business in the real world? Bring your brand to life with professional-quality apparel and promotional items, printed to your needs.',
        items: [
          '**Textile Marking:** Screen printing, flock, digital printing (DTG), embroidery and sublimation.',
          '**Promotional Items:** Reusable cups (Ecocups), stickers, caps and custom accessories.',
          '**Centralised Production:** From small runs to large-scale event production.',
        ],
        cta: 'See the Printing solutions',
      },
    ],
    philosophy: {
      eyebrow: 'Our philosophy',
      title: 'One is all, all is one.',
      question: 'Why juggle several providers when a single entity can master your entire value chain?',
      text: 'That is the philosophy of **Entité & Co**. From designing your visual identity, to developing your AI-powered web platform, to physically printing your merchandise: we connect every dot of your project. A global vision for a consistent, impactful result.',
    },
  },
};

const { lang } = Astro.props;
const c = copy[lang];
const t = useTranslations(lang);
const l = (path: string) => localizePath(path, lang);

/** « **Libellé :** texte » → { label, text }. */
const splitFeature = (item: string) => {
  const match = /^\*\*(.+?)\s*:\*\*\s*(.*)$/.exec(item);
  return match ? { label: match[1] ?? item, text: match[2] ?? '' } : { label: item, text: '' };
};

const PrimaryIcon = expertiseIcons[c.primary.slug];
---

<Layout title={c.seo.title} description={c.seo.description}>
  <!-- Héro -->
  <section class="container-site flex min-h-dvh flex-col justify-center gap-12 pt-32 pb-16">
    <div class="flex flex-col gap-8">
      <p
        class="flex items-center gap-3 font-display text-xs font-medium tracking-[0.3em] text-accent uppercase sm:text-sm"
      >
        <span aria-hidden="true" class="h-px w-8 bg-brand"></span>
        Entité & Co
      </p>
      <h1 class="max-w-6xl text-5xl leading-[0.95] font-bold text-fg sm:text-7xl lg:text-8xl">
        {c.hero.title[0]} <span class="text-accent">&</span>{' '}{c.hero.title[1]}
      </h1>
      <p class="max-w-2xl text-lg text-fg-muted sm:text-xl">{c.hero.intro}</p>
      <div class="flex flex-wrap gap-3">
        <Button href="#expertises" size="lg" icon={ArrowDownIcon}>{c.hero.cta}</Button>
        <Button href={l('/contact')} size="lg" variant="secondary">{t('common.discussProject')}</Button>
      </div>
    </div>

    <ul class="flex flex-wrap gap-2" aria-label={c.stackLabel}>
      {
        keyStack.map((tool) => (
          <li class="rounded-md border border-line bg-fg/5 px-2.5 py-1 font-mono text-xs text-fg-muted sm:text-sm">
            {tool}
          </li>
        ))
      }
    </ul>
  </section>

  <div id="expertises" class="container-site flex scroll-mt-20 flex-col gap-20 border-t border-line py-20 sm:gap-28 sm:py-28">
    <!-- Offre principale -->
    <section id={c.primary.slug} aria-labelledby={`${c.primary.slug}-titre`}>
      <article class="glass card-hover reveal grid gap-10 rounded-3xl p-6 sm:p-10 lg:grid-cols-12 lg:gap-14 lg:p-14">
        <div class="flex flex-col gap-6 lg:col-span-5">
          <div class="flex items-center gap-4">
            <span class="grid size-12 place-items-center rounded-xl border border-line bg-fg/5 text-accent">
              <PrimaryIcon aria-hidden="true" className="size-6" weight="regular" />
            </span>
            <span class="font-mono text-xs tracking-[0.2em] text-accent uppercase sm:text-sm">
              {c.primaryLabel}
            </span>
          </div>
          <h2 id={`${c.primary.slug}-titre`} class="text-3xl leading-[1.05] font-bold text-fg sm:text-5xl">
            {c.primary.title}
          </h2>
          <p class="text-lg text-fg-muted">{c.primary.text}</p>
          <Button href={l(`/expertises/${c.primary.slug}`)} icon={ArrowRightIcon} class="mt-2 w-fit">
            {c.primary.cta}
          </Button>
        </div>
        <dl class="grid gap-4 lg:col-span-7">
          {
            c.primary.items.map((item, i) => {
              const feature = splitFeature(item);
              return (
                <div class="flex gap-5 rounded-2xl border border-line bg-fg/[0.02] p-5 sm:p-6">
                  <span aria-hidden="true" class="font-mono text-sm text-accent tabular-nums">
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  <div>
                    <dt class="font-display text-lg font-semibold text-fg sm:text-xl">{feature.label}</dt>
                    <dd class="mt-2 text-fg-muted">{feature.text}</dd>
                  </div>
                </div>
              );
            })
          }
        </dl>
      </article>
    </section>

    <!-- Compétences transverses -->
    <section aria-labelledby="ecosysteme-titre" class="flex flex-col gap-10">
      <div class="flex max-w-3xl flex-col gap-4">
        <p class="font-mono text-xs tracking-[0.2em] text-accent uppercase sm:text-sm">{c.ecosystem.eyebrow}</p>
        <h2 id="ecosysteme-titre" class="text-2xl leading-tight font-bold text-fg sm:text-4xl">
          {c.ecosystem.title}
        </h2>
        <p class="text-fg-muted">{c.ecosystem.intro}</p>
      </div>
      <div class="grid gap-4 sm:gap-6 md:grid-cols-2">
        {
          c.transverse.map((item) => {
            const ItemIcon = expertiseIcons[item.slug];
            return (
              <article
                id={item.slug}
                aria-labelledby={`${item.slug}-titre`}
                class="glass card-hover reveal relative flex flex-col gap-5 rounded-2xl p-6 sm:p-8"
              >
                <span class="grid size-11 place-items-center rounded-xl border border-line bg-fg/5 text-accent">
                  <ItemIcon aria-hidden="true" className="size-5" weight="regular" />
                </span>
                <h3 id={`${item.slug}-titre`} class="text-xl font-bold text-fg sm:text-2xl">
                  {item.title}
                </h3>
                <p class="text-fg-muted">{item.text}</p>
                <ul class="flex flex-col gap-3 border-t border-line pt-5 text-sm">
                  {item.items.map((point) => (
                    <li class="flex gap-3 text-fg-muted">
                      <span aria-hidden="true" class="mt-2 size-1 shrink-0 rounded-full bg-brand" />
                      <span set:html={inlineMarkdown(point)} />
                    </li>
                  ))}
                </ul>
                <a
                  href={l(`/expertises/${item.slug}`)}
                  class="group/link mt-auto inline-flex min-h-11 w-fit cursor-pointer items-center gap-2 font-display text-sm font-semibold text-fg transition-colors duration-200 hover:text-accent after:absolute after:inset-0 after:rounded-2xl"
                >
                  {item.cta}
                  <ArrowRightIcon
                    aria-hidden="true"
                    className="size-4 transition-transform duration-300 ease-out-expo group-hover/link:translate-x-0.5"
                    weight="bold"
                  />
                </a>
              </article>
            );
          })
        }
      </div>
    </section>
  </div>

  <!-- Philosophie -->
  <section
    aria-labelledby="philosophie"
    class="relative isolate overflow-hidden border-t border-line py-24 sm:py-36"
  >
    <div
      aria-hidden="true"
      class="absolute inset-0 -z-10 bg-[radial-gradient(45rem_25rem_at_50%_50%,rgb(230_0_0/0.14),transparent_70%)]"
    >
    </div>
    <div class="container-site flex flex-col items-center gap-8 text-center">
      <p class="font-display text-xs font-medium tracking-[0.3em] text-accent uppercase sm:text-sm">
        {c.philosophy.eyebrow}
      </p>
      <h2
        id="philosophie"
        class="reveal max-w-5xl text-5xl leading-[0.95] font-bold text-fg sm:text-7xl lg:text-8xl"
      >
        {c.philosophy.title}
      </h2>
      <p class="max-w-[60ch] text-xl font-medium text-fg">{c.philosophy.question}</p>
      <p class="max-w-[65ch] text-lg text-fg-muted" set:html={inlineMarkdown(c.philosophy.text)} />
      <Button href={l('/contact')} size="lg" icon={ArrowRightIcon}>{t('common.discussProject')}</Button>
    </div>
  </section>
</Layout>
