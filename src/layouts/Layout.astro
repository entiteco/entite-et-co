---
import '@/styles/global.css';
import spaceGroteskWoff2 from '@fontsource-variable/space-grotesk/files/space-grotesk-latin-wght-normal.woff2?url';
import interWoff2 from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import Navbar from '@/components/layout/Navbar.astro';
import Footer from '@/components/layout/Footer.astro';
import favicon from '@/assets/global/entite_co_favicon.webp';
import { site, socials, type NavItem } from '@/data/site';
import { langs, ogLocales } from '@/i18n/ui';
import { getLangFromUrl, localizePath, translatePath, useTranslations } from '@/i18n/utils';

interface Props {
  /** Balise <title> complète (issue de `titre_seo` des fichiers de migration). */
  title?: string;
  /** Meta description (issue de `description_seo`). */
  description?: string;
  /** Empêche l'indexation (pages utilitaires). */
  noindex?: boolean;
  /** Fil d'Ariane (hors Accueil), exposé en JSON-LD BreadcrumbList. */
  breadcrumbs?: readonly NavItem[];
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const {
  title = t('site.defaultTitle'),
  description = t('site.defaultDescription'),
  noindex = false,
  breadcrumbs = [],
} = Astro.props;

const base = Astro.site ?? site.url;
const canonical = new URL(Astro.url.pathname, base).href;

// hreflang : uniquement pour les pages disponibles dans toutes les langues.
const alternates = langs.map((l) => ({ lang: l, path: translatePath(Astro.url.pathname, l) }));
const translated = alternates.every((alternate) => alternate.path !== null);
const defaultAlternate = alternates[0]?.path;

const organizationLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.name,
  url: site.url,
  email: site.email,
  slogan: t('site.slogan'),
  founder: { '@type': 'Person', name: site.founder },
  sameAs: socials.map((s) => s.href),
};

const breadcrumbLd =
  breadcrumbs.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [{ label: t('nav.home'), href: localizePath('/', lang) }, ...breadcrumbs].map((item, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          name: item.label,
          item: new URL(item.href, base).href,
        })),
      }
    : null;
---

<!doctype html>
<html lang={lang} class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Thème : appliqué avant le premier rendu (aucun flash). Ordre : choix mémorisé,
         puis préférence système, sinon sombre (thème par défaut de la marque). -->
    <script is:inline>
      (() => {
        let theme = null;
        try {
          theme = localStorage.getItem('theme');
        } catch {}
        if (theme !== 'light' && theme !== 'dark') {
          theme = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        }
        document.documentElement.classList.toggle('dark', theme === 'dark');
      })();
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {
      translated &&
        alternates.map((alternate) => (
          <link rel="alternate" hreflang={alternate.lang} href={new URL(alternate.path ?? '/', base).href} />
        ))
    }
    {
      translated && defaultAlternate && (
        <link rel="alternate" hreflang="x-default" href={new URL(defaultAlternate, base).href} />
      )
    }

    <meta name="theme-color" content="#fafafa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="dark light" />
    <link rel="icon" type="image/webp" href={favicon.src} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <link rel="preload" href={spaceGroteskWoff2} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={interWoff2} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={ogLocales[lang]} />
    {
      translated &&
        langs
          .filter((l) => l !== lang)
          .map((l) => <meta property="og:locale:alternate" content={ogLocales[l]} />)
    }
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />

    <script type="application/ld+json" set:html={JSON.stringify(organizationLd)} />
    {breadcrumbLd && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />}
  </head>
  <body>
    <div class="bg-atmosphere" aria-hidden="true"></div>

    <a
      href="#contenu"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-(--z-index-modal) focus:rounded-full focus:bg-brand focus:px-5 focus:py-3 focus:text-white"
    >
      {t('nav.skip')}
    </a>

    <Navbar />

    <main id="contenu">
      <slot />
    </main>

    <Footer />
  </body>
</html>
