---
import { ArrowRightIcon } from '@phosphor-icons/react/ssr';
import Layout from '@/layouts/Layout.astro';
import Button from '@/components/ui/Button.astro';
import { localizeNav, mainNav } from '@/data/site';

// Page unique (servie pour toute URL inconnue, y compris sous /en) : en français.
const nav = localizeNav(mainNav, 'fr');
---

<Layout
  title="Page introuvable | Entité & Co"
  description="La page demandée n'existe pas ou a été déplacée."
  noindex
>
  <section class="container-site flex min-h-[80dvh] flex-col justify-center gap-8 pt-32 pb-16">
    <p class="font-display text-8xl font-bold text-accent sm:text-9xl">404</p>
    <h1 class="max-w-3xl text-4xl leading-[1.02] font-bold text-fg sm:text-6xl">
      Cette page n'existe pas (ou plus).
    </h1>
    <p class="max-w-[60ch] text-lg text-fg-muted">
      Le site Entité & Co a fait peau neuve : certaines anciennes adresses ont changé. Retrouvez nos
      contenus depuis les liens ci-dessous.
    </p>
    <div class="flex flex-wrap gap-3">
      <Button href="/" size="lg" icon={ArrowRightIcon}>Retour à l'accueil</Button>
      <Button href="/contact" size="lg" variant="secondary">Nous contacter</Button>
    </div>
    <nav aria-label="Pages du site" class="border-t border-line pt-8">
      <ul class="flex flex-wrap gap-x-6 gap-y-1">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                class="inline-flex min-h-11 cursor-pointer items-center text-fg-muted transition-colors duration-200 hover:text-fg"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </section>
</Layout>
